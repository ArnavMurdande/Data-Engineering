flowchart TD
    %% MLOps Lifecycle: Long-Stay Risk Prediction with MLflow & Unity Catalog
    subgraph Data_Prep["1. Feature Engineering & Anti-Leakage"]
        F1["Input Data: fact_patient_encounter, dim_department, dim_patient"]
