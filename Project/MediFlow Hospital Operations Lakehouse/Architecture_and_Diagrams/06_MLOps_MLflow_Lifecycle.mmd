        G3["Assign Active Deployment Alias: @champion"]
        E5 --> G1
        G1 --> G2
        G2 --> G3
    end

    subgraph Inference["4. Batch Inference & Clinical Action"]
        I1["Load Model: models:/.../long_stay_risk_model@champion"]
        I2["Batch Score Open/Active Hospital Encounters"]
